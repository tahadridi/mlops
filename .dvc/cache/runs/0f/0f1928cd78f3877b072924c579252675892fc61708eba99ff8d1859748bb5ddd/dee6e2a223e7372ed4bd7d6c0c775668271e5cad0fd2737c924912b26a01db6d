      - personal_status
      - other_parties
      - property_magnitude
      - other_payment_plans
      - housing
      - job
      - own_telephone
      - foreign_worker
    split:
      test_size: 0.2
      random_state: 42
    target:
      column: credit_risk
      positive_class: bad
